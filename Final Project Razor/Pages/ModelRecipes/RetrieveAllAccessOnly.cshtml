@page
@model Final_Project_Razor.Pages.ReceitaModel
@{
}
<p>Accepted Recipes</p>
@if (Model.AcceptedRecipes != null)
{
    @foreach (var item in Model.AcceptedRecipes)
    {
        <div>
            <a asp-page="/ModelRecipes/UpdateRecipesBlockedStatus" asp-route-Id="@item.RecipeId">
                <button>@item.Title</button>
            </a>
        </div>

    }
    <br />
}
else
{
    <p>No accepted recipes yet</p>
}

<p>Blocked Recipes</p>
@if(Model.BlockedRecipes != null)
{
    @foreach (var item in Model.BlockedRecipes)
    {
        <div>
            <a asp-page="/ModelRecipes/UpdateRecipesBlockedStatus" asp-route-Id="@item.RecipeId">
                <button>@item.Title</button>
            </a>
        </div>
    }
}
else
{
    <p>No blocked recipes yet</p>
}



