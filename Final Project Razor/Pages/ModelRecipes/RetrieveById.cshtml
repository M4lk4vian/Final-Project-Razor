@page
@model Final_Project_Razor.Pages.ModelRecipes.RetrieveByIdModel
@Html.AntiForgeryToken()
@{
}
@if (Model.Recipe != null)
{
    @if (Model.Recipe.BlockedStatus != true && Model.User.IsAdmin != true)
    {
        <h3>@Model.Recipe.Title</h3>
        <div class="mb-3">
            <span class="badge bg-secondary">@Model.Recipe.Difficulty.DifficultyName</span>
            <span class="badge bg-light text-dark">@Model.Recipe.PrepTime</span>
            <span class="badge bg-light text-dark">@Model.Recipe.Category.CategoryName</span>
            @if (Model.Rating == null || Model.Rating.Rating == 0.0)
            {
                <span class="badge bg-light text-dark">Average Rating: N/A</span>
            }
            else
            {
                <span class="badge bg-light text-dark">Average Rating: @Model.Average</span>
            }
        </div>

        <h5>Preparation Method</h5>
        <p>@Model.Recipe.PrepMethod</p>

        <h5>Ingredients</h5>
        <ul>
            @foreach (var item in Model.IngredientsRecipes)
            {
                <li>@item.Ingredient.IngredientName — @item.Quantity @item.Unit.UnitName</li>
            }
        </ul>

        <div class="d-flex flex-wrap align-items-center gap-3 my-4">
            <button id="favBtn" onclick="toggleFavorite()" class="btn btn-link fs-3 text-decoration-none p-0">
                ☆
            </button>
            <a asp-page="/ModelFavorites/GetAllByUserId" class="btn btn-secondary">My Favorites</a>

            <a asp-area="" asp-page="/ModelComments/Create" asp-route-RecipeId="@Model.Recipe.RecipeId" class="fs-3 text-decoration-none">
                ✍️
            </a>
            @if (Model.Comments != null)
            {
                <a asp-area="" asp-page="/ModelComments/RetrieveCommentsByRecipeId" asp-route-RecipeId="@Model.Recipe.RecipeId" class="btn btn-secondary">
                    Your Comments of this Recipe
                </a>
            }
            else
            {
                <p class="mb-0">You haven't commented this recipe yet</p>
            }
        </div>

        <h5>Comments</h5>
        @if (Model.Comments != null)
        {
            <ul>
                @foreach (var comment in Model.Comments)
                {
                    <li>@comment.Content</li>
                }
            </ul>
        }
        else
        {
            <p>You haven't commented this recipe yet</p>
        }

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-area="" asp-page="/ModelRatings/Create" asp-route-RecipeId="@Model.Recipe.RecipeId" class="btn btn-secondary">Rate this Recipe</a>
        </div>

        <p class="mt-4">If you would like to propose any change to our Recipes, please feel free to do so, down below. We would be happy to consider them!</p>
        <a asp-area="" asp-page="/ModelRecipes/Update" asp-route-RecipeId="@Model.Recipe.RecipeId" class="btn btn-secondary">Recipe Edit</a>

        <script>
            const recipeId = @Model.Recipe.RecipeId;
            const favBtn = document.getElementById("favBtn");
            let isFavorite = false;
            favBtn.textContent = isFavorite ? "★" : "☆";
            async function toggleFavorite() {
                const response = await fetch("?handler=ToggleFavorite", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        "RequestVerificationToken": document.querySelector(
                            'input[name="__RequestVerificationToken"]').value
                    },
                    body: `ToggleRecipeId=${recipeId}`
                });
                const data = await response.json();
                if (data.success) {
                    isFavorite = data.isFavorite;
                    favBtn.textContent = isFavorite ? "★" : "☆";
                } else {
                    alert("Erro: " + data.message);
                }
            }
        </script>
    }
}
else
{
    <p>We are out of recipes. Hope you are not starving.</p>
}
