@page
@model Final_Project_Razor.Pages.ModelRecipes.RetrieveAllModel
@{
}
@if (Model.Recipes != null)
{
    @foreach (var item in Model.Recipes)
    {

        <div>
            <a asp-page="/ModelRecipes/RetrieveById" asp-route-recipeId="@item.RecipeId"><button>@item.Title</button></a>

            <br />
        </div>

    }
}
else 
{
    <p>We are out of Recipes. Hope you are not starving</p>
}




