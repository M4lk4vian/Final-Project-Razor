@page
@model Final_Project_Razor.Pages.ModelRecipes.RetrieveAllBlockedModel
@{
}
@if (Model.Recipes != null)
{
    @foreach (var item in Model.Recipes)
    {
        <div>
            <a asp-page="/ModelRecipes/UpdateRecipeBlockedStatus" asp-route-RecipeId="@item.RecipeId">
                <button>@item.Title</button>
            </a>
        </div>

    }
}
else
{
    <p>We are out of Recipes. Hope you are not starving</p>
}
