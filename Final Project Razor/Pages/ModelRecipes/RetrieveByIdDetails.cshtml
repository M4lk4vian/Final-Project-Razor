@page
@model Final_Project_Razor.Pages.ModelRecipes.RetrieveByIdDetailsModel
@{
}
@if (Model.Recipe != null)
{
    @if (Model.Recipe.BlockedStatus != true)
    {
        <h3>@Model.Recipe.Title</h3>
        <div class="mb-3">
            <span class="badge bg-secondary">@Model.Recipe.Difficulty.DifficultyName</span>
            <span class="badge bg-light text-dark">@Model.Recipe.PrepTime</span>
            <span class="badge bg-light text-dark">@Model.Recipe.Category.CategoryName</span>
            @if (Model.Rating != null && Model.Rating.Rating != 0.0)
            {
                <span class="badge bg-light text-dark">Average Rating: @Model.Average</span>
            }
            else
            {
                <span class="badge bg-light text-dark">Average Rating: N/A</span>
            }
        </div>

        <h5>Preparation Method</h5>
        <p>@Model.Recipe.PrepMethod</p>

        <h5>Ingredients</h5>
        <ul>
            @foreach (var item in Model.IngredientsRecipes)
            {
                <li>@item.Ingredient.IngredientName — @item.Quantity @item.Unit.UnitName</li>
            }
        </ul>
    }
}
else
{
    <p>We are out of Recipes. Hope you are not starving</p>
}
