@page
@model Final_Project_Razor.Pages.ModelRecipes.RetrieveAllDetailsModel
@{
}
@if (Model.Recipes != null && Model.Recipes.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Recipes)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@item.Category.CategoryName</h6>
                        <p class="card-text">
                            <span class="badge bg-secondary">@item.Difficulty.DifficultyName</span>
                            <span class="badge bg-light text-dark">@item.PrepTime</span>
                        </p>
                        <a asp-page="/ModelRecipes/RetrieveByIdDetails" asp-route-RecipeId="@item.RecipeId" class="btn btn-primary">View Recipe</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>We are out of Recipes. Hope you are not starving</p>
}
