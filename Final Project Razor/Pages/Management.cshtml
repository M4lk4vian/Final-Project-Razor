@page
@model Final_Project_Razor.Pages.ModelUsers.ManagementModel
@{
}
<h2 class="mb-4">Welcome to our website, @Model.User.UserName</h2>

@if (Model.User.IsAdmin == false)
{
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-area="" asp-page="/ModelRecipes/Create" asp-route-UserId="@Model.User.UserId" class="btn btn-primary">Create a Recipe</a>
        <a asp-area="" asp-page="/ModelRecipes/RetrieveAll" asp-route-UserId="@Model.User.UserId" class="btn btn-primary">Show all Recipes</a>
        <a asp-area="" asp-page="/ModelFavorites/GetAllByUserId" asp-route-UserId="@Model.User.UserId" class="btn btn-primary">Show all Favorites</a>
        <a asp-area="" asp-page="/ModelUsers/UpdateUserInfo" class="btn btn-primary">Update User Information</a>
        <a asp-area="" asp-page="/ModelComments/RetrieveCommentsByUserId" class="btn btn-primary">See all of your Comments</a>
    </div>
}

@if (Model.User.IsAdmin != false)
{
    <div class="d-flex flex-wrap gap-2">
        <a asp-area="" asp-page="/ModelIngredients/Create" class="btn btn-secondary">Create an Ingredient</a>
        <a asp-area="" asp-page="/ModelCategories/Create" class="btn btn-secondary">Create a Category</a>
        <a asp-area="" asp-page="/ModelCategories/RetrieveAll" class="btn btn-secondary">See All Categories</a>
        <a asp-area="" asp-page="/ModelUnits/Create" class="btn btn-secondary">Create a Unit</a>
        <a asp-area="" asp-page="/ModelUnits/RetrieveAll" class="btn btn-secondary">See All Units</a>
        <a asp-area="" asp-page="/ModelDifficulties/Create" class="btn btn-secondary">Rate difficulty</a>
        <a asp-area="" asp-page="/ModelDifficulties/RetrieveAll" class="btn btn-secondary">See All Difficulties</a>
        <a asp-area="" asp-page="/ModelUsers/RetrieveAll" class="btn btn-secondary">Users Access Management</a>
        <a asp-area="" asp-page="/ModelRecipes/RetrieveAllAccessOnly" class="btn btn-secondary">Recipes Access Management</a>
    </div>
}

<div class="text-center mt-5">
    <a href="/ModelRecipes/RetrieveAllDetails" target="_self">
        <img src="https://www.saturdayeveningpost.com/wp-content/uploads/satevepost/2019-04-19-pac-man-eating-veggies-shutterstock-860x573.jpg" width="500px" height="300px" class="rounded" />
    </a>
</div>
