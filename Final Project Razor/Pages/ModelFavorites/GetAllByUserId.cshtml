@page
@model Final_Project_Razor.Pages.ModelFavorites.GetAllByUserIdModel
@{
}

@if (Model.Favorites == null || !Model.Favorites.Any())
{
    <p>At the moment, you don't have any Favorite Recipes</p>
    <br />
    <a asp-area="" asp-page="/ModelRecipes/RetrieveAll">
        <button type="button" class="btn btn-secondary">Click to view all Recipes</button>
    </a>
}
else
{
    @foreach (var item in Model.Favorites)
    {
        <div>
            <p>@item.Recipe.Title</p>
        </div>
    }
}