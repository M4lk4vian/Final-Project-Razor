<!DOCTYPE html>
<html lang="en">
<head style="background-color: lightslategray; color:darkblue">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <title>@ViewData["Title"] - Final_Project_Razor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Final_Project_Razor.styles.css" asp-append-version="true" />
</head>
<body style="background-color: lightslategray; color:blue">
    
    <header style="background-color: lightslategray; color:blue">
        <div class="search-button">
            <form class="example" action="action_page.php">
                <input type="text" placeholder="Search.." name="search">
                <button type="submit"><i class="fa fa-search"></i></button>
            </form>
        </div>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Home Page</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (Context.Session.GetString("user") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/ModelUsers/Logout">Logout</a>
                            </li>
                        }
                        else
                        {

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/ModelUsers/Login">Login</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/ModelUsers/Register">Register</a>
                        </li>
                        @if(Model.User != null)
                        {
                            <li class="text-center" style="list-style-type: none; color:blue">
                                <a class="nav-link text-blue" asp-area="" asp-page="/ModelRecipes/RetrieveAllDetails">Recipes</a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

        <main role="main" class="pb-3" >
            
            @RenderBody()
            <div>
                <a href="/ModelRecipes/RetrieveAllDetails" target="_self" style="text-align:center; display: flex; justify-content: center">
                <img src="https://www.saturdayeveningpost.com/wp-content/uploads/satevepost/2019-04-19-pac-man-eating-veggies-shutterstock-860x573.jpg" width="500px" height="300px" />@*Meter a funcionar*@
                </a>

                <br />
            <li style="list-style-type: none;">For more options, please Register and/or Login in our page</li>
            </div>
            
        </main>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2024 - Someone's hungry... 
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

