@page
@model Final_Project_Razor.Pages.ModelComments.CreateModel
@{
}


<div>
    <label>What do you think of this Recipe?</label><br />
    <label>Welcome User @Model.Comment.User.UserName</label>
    <br /><br /><br />

    <form method="post">
        <input type="hidden" value="@Model.Comment.Recipe.RecipeId" name="Id_recipe" />
        <input type="hidden" value="@Model.Comment.User.UserId" name="Id_user" />
        <label for="Content">Please comment here:</label> 
        <textarea name="Content" id="Content" rows="4" placeholder="Write your comment here..."></textarea>

        <button type="submit" class="btn btn-primary">Submit</button>
        <br />
    </form>
</div>