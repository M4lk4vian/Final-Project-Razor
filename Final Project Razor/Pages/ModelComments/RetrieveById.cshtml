@page
@model Final_Project_Razor.Pages.ModelComments.RetrieveByIdModel
@{
}
@if(Model.Comment != null)
{
    <p>@Model.Comment.Content</p>
    <p>Recipe: @Model.Comment.Recipe.Title</p>
    <a asp-page="/ModelComments/RetrieveById"
        asp-route-CommentId="@Model.Comment.CommentId">View comment</a>

}
else
{
    <p>This recipe has no comments yet</p>
}