@page
@model Final_Project_Razor.Pages.ModelComments.RetrieveCommentsByUserIdModel
@{
}

@if(Model.Comments != null)
{
    @foreach (var item in Model.Comments)
    {
        <a asp-page="/ModelComments/Update" asp-route-UserId="@item.User.UserId">
            <button>@item.Content</button>
        </a>
    }
}
else
{
    <p>This user hasn't commented any recipe yet</p>
}