@page
@model Final_Project_Razor.Pages.ModelComments.RetrieveCommentsByRecipeIdModel
@{
}
@if(Model.Comments != null)
{

    @foreach (var item in Model.Comments)
    {
        <a asp-page="/ModelComments/Update" asp-route-RecipeId="@item.Recipe.RecipeId">
            <button>@item.Content</button>
        </a>
    }
}
else
{
    <p>This Recipe has no comments yet</p>
}
